PORT=5000

# Frontend origin allowed by CORS (the Vite dev server is always allowed)
FRONTEND_URL=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testverse
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/testverse

JWT_SECRET=

# Brevo transactional email — https://app.brevo.com → SMTP & API → API keys.
# The sender address must be a verified sender in Brevo.
# When BREVO_API_KEY is empty outside production, OTPs are printed to the
# server console instead of emailed, so local sign-up still works.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Testverse

# Cashfree Payment Gateway — https://merchant.cashfree.com → Developers → API keys.
# CASHFREE_MODE=TEST uses the sandbox (sandbox keys); anything else is live (PROD).
CASHFREE_MODE=TEST
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Nothing else to set: the webhook URL (<this backend>/api/payments/webhook) is
# sent with every order automatically. FRONTEND_URL (above) must be the https
# site in live mode — Cashfree returns students to <FRONTEND_URL>/payment/return.

# Dev only, when Cashfree isn't configured: "true" activates a purchase instantly
# so the flow can be tested without paying. Ignored when NODE_ENV=production.
MOCK_PAYMENTS=false
