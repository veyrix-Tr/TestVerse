PORT=5000

# Frontend origin allowed by CORS (the Vite dev server is always allowed)
FRONTEND_URL=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testverse
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/testverse

JWT_SECRET=

# Brevo transactional email — https://app.brevo.com → SMTP & API → API keys.
# The sender address must be a verified sender in Brevo.
# When BREVO_API_KEY is empty outside production, OTPs are printed to the
# server console instead of emailed, so local sign-up still works.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Testverse

# Cashfree Payment Gateway — https://merchant.cashfree.com → Developers → API keys.
# CASHFREE_MODE=TEST uses the sandbox (sandbox keys); anything else is live (PROD).
CASHFREE_MODE=TEST
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Nothing else to set: the webhook URL (<this backend>/api/payments/webhook) is
# sent with every order automatically. FRONTEND_URL (above) must be the https
# site in live mode — Cashfree returns students to <FRONTEND_URL>/payment/return.

# Dev only, when Cashfree isn't configured: "true" activates a purchase instantly
# so the flow can be tested without paying. Ignored when NODE_ENV=production.
MOCK_PAYMENTS=false

# Cloudflare R2 — question diagrams and solution PDFs (lib/storage.js).
# dash.cloudflare.com → R2: two buckets, an API token with Object Read & Write
# on both, and a CORS policy on each bucket: AllowedOrigins = the site's
# address(es), AllowedMethods = GET, PUT, HEAD, AllowedHeaders = content-type.
# Without it every upload from the admin page fails.
# Use img.testverse.in (custom domain) for real tests: Cloudflare rate-limits
# the r2.dev address, and 500 students loading diagrams at once would hit it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket for diagrams, and its public address (img.testverse.in or the
# bucket's r2.dev URL), no trailing slash
R2_IMAGES_BUCKET=testverse-images
R2_IMAGES_URL=
# Only after changing R2_IMAGES_URL (e.g. r2.dev -> img.testverse.in): the old
# address(es), comma-separated, so tests made before the change keep working
R2_IMAGES_OLD_URLS=
# Private bucket for solution PDFs (students get 10-minute links)
R2_FILES_BUCKET=testverse-files
