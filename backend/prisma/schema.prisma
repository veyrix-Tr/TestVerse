generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String
  role            String    @default("student")
  // Exam key the student is preparing for: "neet" | "jee-main" | "jee-advanced"
  exam            String?
  phone           String?
  grade           String?   // "Class 11" | "Class 12" | "Dropper / repeater"
  targetYear      Int?
  state           String?
  city            String?
  // Set when the sign-up OTP is confirmed — every account is created verified.
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscription    Subscription?
  testsCreated    Test[]
  attempts        Attempt[]
  groups          GroupMember[]
  testsAssigned   TestStudent[]
  resources       Resource[]
  announcements   Announcement[]
  notifications   Notification[]
  seriesOrders    SeriesOrder[]
  seriesAccess    SeriesStudent[]
  payments        Payment[]
}

// A plan a student buys: one exam + class, e.g. "11th JEE". Tests are later
// given to batches, so a student only sees the tests of the batch they bought.
model Batch {
  id        String   @id @default(cuid())
  name      String   @unique
  exam      String   // "jee" | "neet"
  grade     String   // "Class 11" | "Class 12" | "Dropper / repeater"
  price     Int?     // in rupees; null until pricing is decided
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  tests         TestBatch[]
  series        SeriesBatch[]
  payments      Payment[]

  @@unique([exam, grade])
}

// One-time purchase of a batch. A student can hold only one (userId is unique).
// "pending" until the payment is confirmed, then "active".
model Subscription {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId     String
  batch       Batch     @relation(fields: [batchId], references: [id])
  status      String    @default("pending") // "pending" | "active"
  amount      Int?      // rupees charged, copied from the batch at purchase time
  paymentRef  String?   // gateway order/payment id (Cashfree), once payments exist
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([batchId])
}

// One live OTP per (email, purpose). Only a SHA-256 hash of the code is kept,
// and a record is dropped after too many wrong guesses.
model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  purpose   String   // "signup" | "reset"
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, purpose])
}

// A test an admin builds from a JSON question paper (docs/test-format.md).
// `paper` is the checked, normalised paper including answers and solutions;
// students only ever receive it without them until they submit.
// Later: a TestBatch table will say which batches may attempt it.
model Test {
  id            String    @id @default(cuid())
  title         String
  subject       String    // e.g. "Physics" or "Physics, Chemistry, Maths"
  exam          String?   // "jee" | "neet" | null
  durationMin   Int
  instructions  String    @default("")
  marking       Json      // default marks per question type
  languages     String[]  @default(["en"])
  paper         Json?     // null while a draft has no paper yet
  source        Json?     // the JSON exactly as the admin gave it, for editing
  questionCount Int       @default(0)
  totalMarks    Float     @default(0)
  status        String    @default("draft") // "draft" | "published"
  // Who may take it: "all" = every student, "custom" = only the batches,
  // groups and students listed in TestBatch / TestGroup / TestStudent.
  audience      String    @default("all")
  // A free test: every student of its exam (any exam if `exam` is null) may
  // take it, with or without a batch. `audience` doesn't apply to it.
  isFree        Boolean   @default(false)
  // Which admin section it belongs to: "free" (Free tests, isFree = true),
  // "live" (Live tests: has a start time, given to chosen people or all paid
  // students) or "series" (stored inside a TestSeries, shown to nobody yet).
  kind          String    @default("live")
  // Position inside its series: 0, 1, 2… in the order the admin wants (Move up /
  // Move down in Admin › Test series). Tests added to a series are appended.
  sortOrder     Int       @default(0)
  seriesId      String?
  series        TestSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  opensAt       DateTime? // students may start from…
  closesAt      DateTime? // …until (both optional)
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  attempts      Attempt[]
  batches       TestBatch[]
  groups        TestGroup[]
  students      TestStudent[]

  @@index([status])
  @@index([isFree])
  @@index([kind])
  @@index([seriesId])
}

// A test series an admin builds and sells: a named set of tests with a
// one-time price. `status` is the series' own publish switch (the tests inside
// follow it — test-level publish stays blocked for kind "series"), `audience`
// is who may see and buy it, and a SeriesOrder is one student's purchase.
model TestSeries {
  id          String   @id @default(cuid())
  title       String
  exam        String?  // "jee" | "neet" | null
  description String   @default("")
  // One-time price in rupees; null = not set (publishing requires it, 0 = free)
  price       Int?
  status      String   @default("draft") // "draft" | "published"
  publishedAt DateTime?
  // Who may see and buy it: "all" (every student of its exam) or "custom"
  // (the batches / groups / students listed below).
  audience    String   @default("all")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tests       Test[]
  batches     SeriesBatch[]
  groups      SeriesGroup[]
  students    SeriesStudent[]
  orders      SeriesOrder[]
  payments    Payment[]
}

// Who a "custom" series is sold to: batches, groups and individual students.
model SeriesBatch {
  seriesId String
  series   TestSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  batchId  String
  batch    Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([seriesId, batchId])
  @@index([batchId])
}

model SeriesGroup {
  seriesId String
  series   TestSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([seriesId, groupId])
  @@index([groupId])
}

model SeriesStudent {
  seriesId String
  series   TestSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([seriesId, userId])
  @@index([userId])
}

// One student's purchase of one series. "pending" until the payment is
// confirmed, then "active" (which is what unlocks the series' tests).
// The amount is copied from the series at purchase time, so a later price
// change never touches an old order.
model SeriesOrder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId    String
  series      TestSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // "pending" | "active"
  amount      Int?      // rupees charged
  paymentRef  String?   // gateway order/payment id (Cashfree), once payments exist
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, seriesId])
  @@index([seriesId])
}

// One Cashfree checkout. A row is written when a student starts paying for a
// batch or a series; the webhook or the return page then confirms the order
// with Cashfree and, once it is PAID, activates the Subscription / SeriesOrder
// it was for. `orderId` is the id Cashfree knows the order by. Kept even if the
// batch or series is later deleted, as the record of money received.
model Payment {
  id          String      @id @default(cuid())
  orderId     String      @unique
  kind        String      // "batch" | "series"
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  seriesId    String?
  series      TestSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  amount      Int         // rupees
  status      String      @default("pending") // "pending" | "paid" | "failed"
  cfPaymentId String?     // Cashfree's payment id, once paid
  paidAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

// One student's attempt at one test. A student may retake a test once they've
// submitted it: each retake is a new row with the next attemptNo (1, 2, …).
// Only the latest attempt can be in progress. The clock is the server's:
// deadline = startedAt + test duration.
model Attempt {
  id            String    @id @default(cuid())
  testId        String
  test          Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNo     Int       @default(1)
  startedAt     DateTime  @default(now())
  deadline      DateTime
  responses     Json      @default("{}") // { [questionId]: { answer, marked, visited, timeMs } }
  submittedAt   DateTime?
  autoSubmitted Boolean   @default(false)
  score         Float?
  maxScore      Float?
  correct       Int?
  wrong         Int?
  partial       Int?
  skipped       Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([testId, userId, attemptNo])
  @@index([userId])
}

// A named set of students an admin makes by hand (e.g. "Revision group"),
// used to give tests to many students at once.
model Group {
  id          String        @id @default(cuid())
  name        String        @unique
  description String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     GroupMember[]
  tests       TestGroup[]
  series      SeriesGroup[]
}

model GroupMember {
  groupId String
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

// Who a "custom" test is given to: batches, groups and individual students.
model TestBatch {
  testId  String
  test    Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([testId, batchId])
  @@index([batchId])
}

model TestGroup {
  testId  String
  test    Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([testId, groupId])
  @@index([groupId])
}

model TestStudent {
  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([testId, userId])
  @@index([userId])
}

// A YouTube video shown in the homepage's "Resources" section. Admins add them
// from Admin > Website info; visitors see only the published ones.
model Resource {
  id          String   @id @default(cuid())
  title       String
  videoId     String   // YouTube video id (watch?v=...) or playlist id (list=...)
  kind        String   @default("video") // "video" | "playlist"
  exam        String?  // "neet" | "jee-main" | "jee-advanced" | null = for everyone
  topic       String?  // short free-text tag, e.g. "Physics" or "Strategy"
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

// A message shown on the homepage strip (visitors) and as a banner in the
// student dashboard. `audience` decides who sees it:
//   "all" | "students" | "paid" | "exam:neet" | "exam:jee-main" | ...
model Announcement {
  id          String    @id @default(cuid())
  body        String
  audience    String    @default("all")
  link        String?   // optional "Learn more" URL
  startsAt    DateTime  @default(now())
  endsAt      DateTime? // null = runs until it is switched off
  isActive    Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reads       AnnouncementRead[]

  @@index([isActive])
}

// One row per (announcement, student) who has seen it - the read receipt the
// admin sees as "N of M read".
model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
  @@index([userId])
}

// The notification inbox. One row per event:
//   userId = null  -> the ADMIN's bell (new signup, new purchase, ...)
//   userId = <id>  -> that STUDENT's bell (batch active, new test, welcome, ...)
// `view` names where to go: a sidebar view for admins, a route for students.
model Notification {
  id        String    @id @default(cuid())
  type      String // "signup" | "purchase" | "welcome" | "test" | ...
  text      String
  view      String?   // admin: sidebar view "students"; student: "/student/tests"
  readAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

// Website-wide settings managed from Admin > Website info. Single row.
model WebsiteSettings {
  id                String  @id @default(cuid())
  announcement      String  @default("")
  showAnnouncement  Boolean @default(false)
  youtubeChannel    String  @default("")
  youtubePlaylists  Json    @default("{}") // { "neet": "url", "jee-main": "url", "jee-advanced": "url" }
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}
